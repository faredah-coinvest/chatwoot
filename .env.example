# =============================================================================
# Chatwoot environment template
# Copy to `.env` on the server (never commit `.env`). Replace every <PLACEHOLDER>.
# Full variable reference: https://www.chatwoot.com/docs/self-hosted/configuration/environment-variables
# =============================================================================

# -----------------------------------------------------------------------------
# Docker image (docker-compose.production.yaml)
# Set to the image your CI pushes, e.g. <account>.dkr.ecr.<region>.amazonaws.com/<repo>:latest
# -----------------------------------------------------------------------------
CHATWOOT_IMAGE=<ECR_REGISTRY>/<ECR_REPOSITORY>:latest

# -----------------------------------------------------------------------------
# Core (secrets — generate/store outside git)
# -----------------------------------------------------------------------------
# `bundle exec rake secret` (or `openssl rand -hex 64`)
SECRET_KEY_BASE=<GENERATE_WITH_RAKE_SECRET>

# Active Record Encryption (required for MFA/2FA): `rails db:encryption:init`
# ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
# ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
# ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

FRONTEND_URL=https://<YOUR_PUBLIC_HOST>
FORCE_SSL=true
ENABLE_ACCOUNT_SIGNUP=false

RAILS_ENV=production
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info
RAILS_MAX_THREADS=5
RAILS_SERVE_STATIC_FILES=true

# -----------------------------------------------------------------------------
# Traefik / HTTPS (docker-compose.production.yaml)
# -----------------------------------------------------------------------------
FRONTEND_HOST=<YOUR_PUBLIC_HOST>
LETSENCRYPT_EMAIL=<YOUR_EMAIL_FOR_LETSENCRYPT>

# -----------------------------------------------------------------------------
# Postgres (e.g. RDS) — use strong credentials from a secrets manager
# -----------------------------------------------------------------------------
POSTGRES_HOST=<RDS_ENDPOINT>
POSTGRES_DATABASE=<DB_NAME>
POSTGRES_USERNAME=<DB_USER>
POSTGRES_PASSWORD=<DB_PASSWORD>
# POSTGRES_PORT=5432
# POSTGRES_STATEMENT_TIMEOUT=14s

# Optional: single URL instead of discrete vars (if your deploy uses it)
# DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DBNAME>

# -----------------------------------------------------------------------------
# Redis (container in compose, or ElastiCache)
# REDIS_PASSWORD must match the password embedded in REDIS_URL for docker Redis.
# -----------------------------------------------------------------------------
REDIS_PASSWORD=<STRONG_REDIS_PASSWORD>
REDIS_URL=redis://:<STRONG_REDIS_PASSWORD>@redis:6379
# REDIS_SENTINELS=
# REDIS_SENTINEL_MASTER_NAME=
# REDIS_SENTINEL_PASSWORD=
# REDIS_OPENSSL_VERIFY_MODE=none

# -----------------------------------------------------------------------------
# Active Storage — S3 (IAM user or instance role; keys only if not using IAM role on host)
# -----------------------------------------------------------------------------
ACTIVE_STORAGE_SERVICE=amazon
S3_BUCKET_NAME=<S3_BUCKET>
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_OR_LEAVE_EMPTY_IF_INSTANCE_ROLE>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_KEY_OR_LEAVE_EMPTY_IF_INSTANCE_ROLE>
AWS_REGION=<AWS_REGION>

# Optional CDN / direct uploads
# ASSET_CDN_HOST=
# DIRECT_UPLOADS_ENABLED=true

# -----------------------------------------------------------------------------
# SMTP (uncomment when ready)
# -----------------------------------------------------------------------------
# MAILER_SENDER_EMAIL=Chatwoot <noreply@example.com>
# SMTP_DOMAIN=example.com
# SMTP_ADDRESS=email-smtp.<region>.amazonaws.com
# SMTP_PORT=587
# SMTP_USERNAME=<SES_SMTP_USERNAME>
# SMTP_PASSWORD=<SES_SMTP_PASSWORD>
# SMTP_AUTHENTICATION=login
# SMTP_ENABLE_STARTTLS_AUTO=true
# SMTP_OPENSSL_VERIFY_MODE=peer
# SMTP_TLS=
# SMTP_SSL=
# SMTP_OPEN_TIMEOUT=
# SMTP_READ_TIMEOUT=

# -----------------------------------------------------------------------------
# Mail / inbound (optional)
# -----------------------------------------------------------------------------
# MAILER_INBOUND_EMAIL_DOMAIN=
# EMAIL_PROCESSING_TIMEOUT_SECONDS=60
# RAILS_INBOUND_EMAIL_SERVICE=
# RAILS_INBOUND_EMAIL_PASSWORD=
# MAILGUN_INGRESS_SIGNING_KEY=
# MANDRILL_INGRESS_API_KEY=
# ACTION_MAILBOX_SES_SNS_TOPIC=

# -----------------------------------------------------------------------------
# Push / mobile
# -----------------------------------------------------------------------------
ENABLE_PUSH_RELAY_SERVER=true
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# FCM_SERVER_KEY=

# -----------------------------------------------------------------------------
# Integrations & ops (optional — see upstream docs)
# -----------------------------------------------------------------------------
# FB_APP_ID=  FB_APP_SECRET=  FB_VERIFY_TOKEN=
# SLACK_CLIENT_ID=  SLACK_CLIENT_SECRET=
# GOOGLE_OAUTH_CLIENT_ID=  GOOGLE_OAUTH_CLIENT_SECRET=  GOOGLE_OAUTH_CALLBACK_URL=
# SENTRY_DSN=
# SCOUT_KEY=
# SCOUT_NAME=
# SCOUT_MONITOR=true
# NEW_RELIC_LICENSE_KEY=
# NEW_RELIC_APPLICATION_LOGGING_ENABLED=
# DD_TRACE_AGENT_URL=
# IP_LOOKUP_API_KEY=
# ENABLE_RACK_ATTACK=true
# RACK_ATTACK_LIMIT=300
# ENABLE_RACK_ATTACK_WIDGET_API=true
# RACK_ATTACK_ALLOWED_IPS=127.0.0.1,::1,192.168.0.10
# SAFE_FETCH_ALLOW_PRIVATE_NETWORK=false
# CW_API_ONLY_SERVER=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# DIRECT_UPLOADS_ENABLED=
# AZURE_APP_ID=
# AZURE_APP_SECRET=
# SIDEKIQ_CONCURRENCY=10
# ENABLE_SIDEKIQ_DEQUEUE_LOGGER=false
# OPENAI_API_KEY=

# -----------------------------------------------------------------------------
# Local development only (do not use these values in production)
# -----------------------------------------------------------------------------
# RAILS_ENV=development
# FRONTEND_URL=http://0.0.0.0:3000
# FORCE_SSL=false
# POSTGRES_HOST=postgres
# POSTGRES_DATABASE=chatwoot
# POSTGRES_USERNAME=postgres
# POSTGRES_PASSWORD=postgres
# REDIS_URL=redis://redis:6379
# REDIS_PASSWORD=
# ACTIVE_STORAGE_SERVICE=local
# S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
